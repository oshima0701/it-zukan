---
// 土台の確認用の図解。OSを包む殻（ターミナルのページで使う形の下書き）。
// 色はCSS変数から受けるのでダークモードに追従する。
---
<svg viewBox="0 0 420 200" role="img" aria-label="OSの中心を、殻のようにターミナルが包んでいる図">
  <rect x="8" y="8" width="404" height="184" rx="12" fill="none" stroke="var(--line)" stroke-width="2" stroke-dasharray="6 5" />
  <text x="20" y="30" font-size="12" fill="var(--ink-soft)">あなた</text>

  <rect x="110" y="40" width="200" height="120" rx="10" fill="var(--tool-bg)" stroke="var(--tool)" stroke-width="2" />
  <text x="210" y="62" font-size="13" font-weight="700" text-anchor="middle" fill="var(--tool)">シェル（殻）</text>

  <rect x="150" y="78" width="120" height="64" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2" />
  <text x="210" y="106" font-size="12" text-anchor="middle" fill="var(--ink)">OSの中心</text>
  <text x="210" y="124" font-size="10" text-anchor="middle" fill="var(--ink-soft)">カーネル</text>

  <path d="M62 100 L104 100" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#arrow)" />
  <circle cx="44" cy="100" r="14" fill="var(--panel)" stroke="var(--line)" stroke-width="2" />
  <text x="44" y="105" font-size="12" text-anchor="middle" fill="var(--ink)">⌨</text>

  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink-soft)" />
    </marker>
  </defs>
</svg>
