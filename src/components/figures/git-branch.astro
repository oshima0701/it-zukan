---
// 枝分かれと合流。記録が一本道ではないことを見せる。
---
<svg viewBox="0 0 440 180" role="img" aria-label="本線から枝が分かれ、別々に記録が進み、最後に本線へ合流する図">
  <text x="14" y="112" font-size="10" fill="var(--ink-soft)">本線</text>
  <text x="14" y="52" font-size="10" fill="var(--tool)">枝</text>

  <path d="M46 104 L404 104" stroke="var(--line-strong, var(--ink-soft))" stroke-width="2.5" fill="none"/>
  <path d="M130 104 Q166 104 166 72 L166 48 L300 48 Q336 48 336 80 L336 104"
        stroke="var(--tool)" stroke-width="2.5" fill="none"/>

  <g fill="var(--panel)" stroke="var(--line-strong, var(--ink-soft))" stroke-width="2.5">
    <circle cx="62" cy="104" r="9"/>
    <circle cx="130" cy="104" r="9"/>
    <circle cx="232" cy="104" r="9"/>
    <circle cx="390" cy="104" r="9"/>
  </g>
  <g fill="var(--panel)" stroke="var(--tool)" stroke-width="2.5">
    <circle cx="200" cy="48" r="9"/>
    <circle cx="268" cy="48" r="9"/>
    <circle cx="336" cy="104" r="10"/>
  </g>

  <text x="130" y="134" font-size="10" text-anchor="middle" fill="var(--ink-soft)">ここで分かれる</text>
  <text x="336" y="140" font-size="10" text-anchor="middle" fill="var(--tool)">ここで合流</text>
  <text x="234" y="30" font-size="10" text-anchor="middle" fill="var(--ink-soft)">本線を壊さずに試せる</text>
  <text x="220" y="166" font-size="10" text-anchor="middle" fill="var(--ink-soft)">丸ひとつが「ここまで」という記録（コミット）</text>
</svg>
