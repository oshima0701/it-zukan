---
// プロジェクトごとに道具箱を分ける。
---
<svg viewBox="0 0 440 200" role="img" aria-label="仮想環境を使わないと道具が一か所で混ざり、使うとプロジェクトごとに分かれるという比較図">
  <text x="104" y="22" font-size="10" fill="var(--ink-soft)">分けない：ひとつの棚に全部</text>
  <rect x="14" y="32" width="180" height="140" rx="10" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <g font-size="10" fill="var(--ink-soft)">
    <rect x="30" y="48" width="148" height="22" rx="5" fill="var(--wash, var(--panel))" stroke="var(--line)"/>
    <text x="104" y="63" text-anchor="middle">部品A（古い版）</text>
    <rect x="30" y="78" width="148" height="22" rx="5" fill="var(--wash, var(--panel))" stroke="var(--line)"/>
    <text x="104" y="93" text-anchor="middle">部品A（新しい版）</text>
    <rect x="30" y="108" width="148" height="22" rx="5" fill="var(--wash, var(--panel))" stroke="var(--line)"/>
    <text x="104" y="123" text-anchor="middle">部品B</text>
  </g>
  <text x="104" y="152" font-size="10" text-anchor="middle" fill="var(--mechanism)">どちらかしか置けず、片方が壊れる</text>

  <text x="336" y="22" font-size="10" fill="var(--tool)">分ける：仕事ごとの箱</text>
  <g>
    <rect x="246" y="32" width="180" height="64" rx="10" fill="var(--tool-bg)" stroke="var(--tool)" stroke-width="2"/>
    <text x="262" y="52" font-size="10" fill="var(--tool)">仕事1の箱</text>
    <rect x="262" y="60" width="148" height="22" rx="5" fill="var(--panel)" stroke="var(--tool)"/>
    <text x="336" y="75" font-size="10" text-anchor="middle" fill="var(--ink)">部品A（古い版）</text>
  </g>
  <g>
    <rect x="246" y="106" width="180" height="64" rx="10" fill="var(--tool-bg)" stroke="var(--tool)" stroke-width="2"/>
    <text x="262" y="126" font-size="10" fill="var(--tool)">仕事2の箱</text>
    <rect x="262" y="134" width="148" height="22" rx="5" fill="var(--panel)" stroke="var(--tool)"/>
    <text x="336" y="149" font-size="10" text-anchor="middle" fill="var(--ink)">部品A（新しい版）</text>
  </g>
  <text x="220" y="192" font-size="10" text-anchor="middle" fill="var(--ink-soft)">同じ部品の違う版が、同じパソコンに同居できる</text>
</svg>
