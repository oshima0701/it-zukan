---
// 共通の中心と、その周りを包む配り方の違い。
---
<svg viewBox="0 0 440 210" role="img" aria-label="同じ中心核をもとに、用途の違う配布版がいくつも作られているという図">
  <circle cx="220" cy="100" r="46" fill="var(--place-bg)" stroke="var(--place)" stroke-width="2"/>
  <text x="220" y="96" font-size="12" font-weight="700" text-anchor="middle" fill="var(--place)">中心核</text>
  <text x="220" y="114" font-size="10" text-anchor="middle" fill="var(--ink-soft)">カーネル</text>

  <g fill="var(--panel)" stroke="var(--line)" stroke-width="2">
    <rect x="18" y="20" width="118" height="34" rx="8"/>
    <rect x="18" y="146" width="118" height="34" rx="8"/>
    <rect x="304" y="20" width="118" height="34" rx="8"/>
    <rect x="304" y="146" width="118" height="34" rx="8"/>
  </g>
  <g font-size="10" text-anchor="middle" fill="var(--ink-soft)">
    <text x="77" y="36">机の上で使う版</text>
    <text x="77" y="50">初心者向け</text>
    <text x="77" y="162">小さな機械の版</text>
    <text x="77" y="176">家電・機器</text>
    <text x="363" y="36">サーバー用の版</text>
    <text x="363" y="50">長く直さず使う</text>
    <text x="363" y="162">スマホの版</text>
    <text x="363" y="176">持ち歩く機械</text>
  </g>

  <g stroke="var(--place)" stroke-width="1.5" stroke-dasharray="4 4">
    <path d="M136 46 L178 80"/>
    <path d="M136 154 L178 120"/>
    <path d="M304 46 L262 80"/>
    <path d="M304 154 L262 120"/>
  </g>
  <text x="220" y="200" font-size="10" text-anchor="middle" fill="var(--ink-soft)">中心は同じで、包み方が違う。だから姿が違っても親戚になる</text>
</svg>
