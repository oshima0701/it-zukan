---
// ネットワーク図の雲マーク。中身を描かない記号が名前になった。
---
<svg viewBox="0 0 440 190" role="img" aria-label="ネットワーク図で、詳細を描かない部分を雲の形で表していたことが名前の由来という図">
  <rect x="14" y="66" width="96" height="48" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="62" y="95" font-size="11" text-anchor="middle" fill="var(--ink)">こちら</text>

  <path d="M114 90 L156 90" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#cl)"/>

  <path d="M186 104 Q164 104 164 86 Q164 68 184 70 Q190 48 212 52 Q228 36 248 52 Q272 48 274 70 Q294 70 292 88 Q292 104 272 104 Z"
        fill="var(--place-bg)" stroke="var(--place)" stroke-width="2"/>
  <text x="228" y="86" font-size="11" text-anchor="middle" fill="var(--place)">ここは描かない</text>
  <text x="228" y="100" font-size="9" text-anchor="middle" fill="var(--ink-soft)">誰かが面倒を見ている</text>

  <path d="M300 90 L342 90" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#cl)"/>

  <rect x="346" y="66" width="80" height="48" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="386" y="95" font-size="11" text-anchor="middle" fill="var(--ink)">あちら</text>

  <text x="220" y="150" font-size="10" text-anchor="middle" fill="var(--ink-soft)">「中身を描かない」ための記号だった雲が、</text>
  <text x="220" y="168" font-size="10" text-anchor="middle" fill="var(--ink-soft)">そのまま商売の名前になった</text>

  <defs>
    <marker id="cl" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink-soft)"/>
    </marker>
  </defs>
</svg>
