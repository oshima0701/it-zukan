---
// COMMAND.COM と cmd.exe の系譜。別物であることを見せる。
---
<svg viewBox="0 0 440 200" role="img" aria-label="MS-DOSのCOMMAND.COMとWindows NTのcmd.exeは別系統で、見た目が似ているだけという図">
  <rect x="14" y="30" width="180" height="62" rx="10" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="104" y="54" font-size="12" text-anchor="middle" fill="var(--ink)">MS-DOS</text>
  <text x="104" y="74" font-size="11" text-anchor="middle" fill="var(--ink-soft)">COMMAND.COM</text>

  <rect x="246" y="30" width="180" height="62" rx="10" fill="var(--tool-bg)" stroke="var(--tool)" stroke-width="2"/>
  <text x="336" y="54" font-size="12" text-anchor="middle" fill="var(--tool)">Windows NT 系</text>
  <text x="336" y="74" font-size="11" text-anchor="middle" fill="var(--ink)">cmd.exe</text>

  <path d="M198 61 L242 61" stroke="var(--line-strong, var(--ink-soft))" stroke-width="2" stroke-dasharray="5 4"/>
  <text x="220" y="52" font-size="10" text-anchor="middle" fill="var(--ink-soft)">別物</text>

  <rect x="14" y="120" width="412" height="62" rx="10" fill="var(--wash, var(--panel))" stroke="var(--line)" stroke-width="1.5" stroke-dasharray="4 4"/>
  <text x="220" y="144" font-size="11" text-anchor="middle" fill="var(--ink-soft)">どちらも「文字で命令する窓口」なので、見た目がよく似ている</text>
  <text x="220" y="164" font-size="11" text-anchor="middle" fill="var(--ink-soft)">いまのWindowsに入っているのは cmd.exe のほう</text>
</svg>
