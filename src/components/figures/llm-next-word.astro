---
// 大規模言語モデルが「次に来そうな言葉」を選んでいるという図。
---
<svg viewBox="0 0 440 210" role="img" aria-label="入力された文の続きとして、確からしさの高い言葉を選び、それを繰り返して文章になるという図">
  <rect x="14" y="26" width="180" height="40" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="104" y="51" font-size="12" text-anchor="middle" fill="var(--ink)">「今日の天気は」</text>

  <path d="M198 46 L236 46" stroke="var(--ai)" stroke-width="2" marker-end="url(#ai-arrow)"/>

  <g>
    <rect x="240" y="18" width="186" height="22" rx="5" fill="var(--ai-bg)" stroke="var(--ai)" stroke-width="2"/>
    <text x="252" y="34" font-size="11" fill="var(--ai)">晴れ</text>
    <rect x="362" y="22" width="52" height="14" rx="3" fill="var(--ai)" opacity="0.85"/>
    <rect x="240" y="46" width="186" height="22" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="252" y="62" font-size="11" fill="var(--ink-soft)">くもり</text>
    <rect x="362" y="50" width="30" height="14" rx="3" fill="var(--ink-soft)" opacity="0.4"/>
    <rect x="240" y="74" width="186" height="22" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="252" y="90" font-size="11" fill="var(--ink-soft)">カレー</text>
    <rect x="362" y="78" width="8" height="14" rx="3" fill="var(--ink-soft)" opacity="0.4"/>
  </g>
  <text x="333" y="112" font-size="10" text-anchor="middle" fill="var(--ink-soft)">続きとしての確からしさ</text>

  <rect x="14" y="140" width="412" height="52" rx="8" fill="var(--wash, var(--panel))" stroke="var(--line)" stroke-width="1.5" stroke-dasharray="4 4"/>
  <text x="220" y="162" font-size="11" text-anchor="middle" fill="var(--ink-soft)">選んだ言葉を文の末尾に足して、また次を選ぶ。これを繰り返す</text>
  <text x="220" y="180" font-size="11" text-anchor="middle" fill="var(--ink-soft)">「正しいこと」ではなく「続きとして自然なこと」を選んでいる</text>

  <defs>
    <marker id="ai-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ai)"/>
    </marker>
  </defs>
</svg>
