---
// 字下げが意味を持つ、という独特の決まり。
---
<svg viewBox="0 0 440 180" role="img" aria-label="ほかの言語が記号で囲む範囲を、Pythonは字下げで表すという比較図">
  <text x="14" y="22" font-size="10" fill="var(--ink-soft)">ほかの言語：記号で囲む</text>
  <g font-size="11" fill="var(--ink-soft)">
    <text x="20" y="46">if (雨) &#123;</text>
    <text x="48" y="64">傘を持つ;</text>
    <text x="20" y="82">&#125;</text>
  </g>
  <rect x="14" y="32" width="180" height="60" rx="6" fill="none" stroke="var(--line)" stroke-width="1.5"/>

  <text x="246" y="22" font-size="10" fill="var(--language)">Python：字下げで表す</text>
  <g font-size="11" fill="var(--ink)">
    <text x="252" y="46">if 雨:</text>
    <text x="280" y="64">傘を持つ</text>
  </g>
  <rect x="246" y="32" width="180" height="60" rx="6" fill="var(--language-bg)" stroke="var(--language)" stroke-width="2"/>
  <path d="M274 54 L274 70" stroke="var(--language)" stroke-width="1.5" stroke-dasharray="3 3"/>

  <rect x="14" y="110" width="412" height="52" rx="8" fill="var(--wash, var(--panel))" stroke="var(--line)" stroke-width="1.5" stroke-dasharray="4 4"/>
  <text x="220" y="132" font-size="11" text-anchor="middle" fill="var(--ink-soft)">見た目の整え方が、そのまま意味になる</text>
  <text x="220" y="150" font-size="11" text-anchor="middle" fill="var(--ink-soft)">だから、読みにくく書く余地が最初から少ない</text>
</svg>
