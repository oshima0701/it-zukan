---
// もっともらしい嘘が生まれる仕組み。
---
<svg viewBox="0 0 440 206" role="img" aria-label="確からしさだけで言葉を選ぶため、事実かどうかを確かめる段がなく、自信のある文章のまま誤りが出るという図">
  <rect x="14" y="30" width="118" height="46" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="73" y="50" font-size="11" text-anchor="middle" fill="var(--ink)">質問</text>
  <text x="73" y="66" font-size="9" text-anchor="middle" fill="var(--ink-soft)">知らないことを聞く</text>

  <path d="M136 53 L168 53" stroke="var(--ai)" stroke-width="2" marker-end="url(#h-arrow)"/>

  <rect x="172" y="30" width="118" height="46" rx="8" fill="var(--ai-bg)" stroke="var(--ai)" stroke-width="2"/>
  <text x="231" y="50" font-size="11" text-anchor="middle" fill="var(--ai)">続きを選ぶ</text>
  <text x="231" y="66" font-size="9" text-anchor="middle" fill="var(--ink-soft)">自然さで選ぶ</text>

  <path d="M294 53 L326 53" stroke="var(--ai)" stroke-width="2" marker-end="url(#h-arrow)"/>

  <rect x="330" y="30" width="96" height="46" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="378" y="50" font-size="11" text-anchor="middle" fill="var(--ink)">答え</text>
  <text x="378" y="66" font-size="9" text-anchor="middle" fill="var(--ink-soft)">自信たっぷり</text>

  <g>
    <rect x="172" y="112" width="118" height="44" rx="8" fill="none" stroke="var(--mechanism)" stroke-width="2" stroke-dasharray="6 5"/>
    <text x="231" y="132" font-size="10" text-anchor="middle" fill="var(--mechanism)">事実か確かめる段</text>
    <text x="231" y="148" font-size="10" text-anchor="middle" fill="var(--mechanism)">（ここが無い）</text>
    <path d="M231 80 L231 108" stroke="var(--mechanism)" stroke-width="1.5" stroke-dasharray="4 4"/>
  </g>

  <text x="220" y="190" font-size="11" text-anchor="middle" fill="var(--ink-soft)">自信の強さは、正しさの目印にならない</text>

  <defs>
    <marker id="h-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ai)"/>
    </marker>
  </defs>
</svg>
