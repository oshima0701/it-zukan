---
// 表から、欲しい行と列だけ取り出す。
---
<svg viewBox="0 0 440 200" role="img" aria-label="表全体から条件に合う行と、必要な列だけを取り出す図">
  <text x="14" y="22" font-size="10" fill="var(--ink-soft)">もとの表</text>
  <g>
    <rect x="14" y="30" width="180" height="120" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
    <rect x="14" y="30" width="180" height="24" rx="6" fill="var(--data-bg)"/>
    <g font-size="9" fill="var(--ink-soft)">
      <text x="30" y="46">名前</text><text x="92" y="46">部署</text><text x="146" y="46">年</text>
      <text x="30" y="72">佐藤</text><text x="92" y="72">営業</text><text x="146" y="72">3</text>
      <text x="30" y="96">鈴木</text><text x="92" y="96">経理</text><text x="146" y="96">7</text>
      <text x="30" y="120">田中</text><text x="92" y="120">営業</text><text x="146" y="120">5</text>
    </g>
    <line x1="14" y1="82" x2="194" y2="82" stroke="var(--line)" stroke-width="1"/>
    <line x1="14" y1="106" x2="194" y2="106" stroke="var(--line)" stroke-width="1"/>
  </g>

  <g>
    <path d="M202 90 L252 90" stroke="var(--data)" stroke-width="2" marker-end="url(#sq)"/>
    <text x="227" y="80" font-size="9" text-anchor="middle" fill="var(--data)">営業だけ</text>
    <text x="227" y="106" font-size="9" text-anchor="middle" fill="var(--data)">名前だけ</text>
  </g>

  <text x="262" y="22" font-size="10" fill="var(--data)">取り出した結果</text>
  <rect x="262" y="30" width="110" height="78" rx="6" fill="var(--panel)" stroke="var(--data)" stroke-width="2"/>
  <rect x="262" y="30" width="110" height="24" rx="6" fill="var(--data-bg)"/>
  <g font-size="9" fill="var(--ink)">
    <text x="278" y="46">名前</text>
    <text x="278" y="72">佐藤</text>
    <text x="278" y="96">田中</text>
  </g>
  <line x1="262" y1="82" x2="372" y2="82" stroke="var(--line)" stroke-width="1"/>

  <text x="220" y="180" font-size="10" text-anchor="middle" fill="var(--ink-soft)">どう取り出すかではなく、何が欲しいかを書く</text>

  <defs>
    <marker id="sq" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--data)"/>
    </marker>
  </defs>
</svg>
