---
// ターミナル・シェル・カーネルの関係。外側から内側へ三重。
---
<svg viewBox="0 0 440 230" role="img" aria-label="あなたが打った文字がターミナルに入り、シェルが受け取ってOSの中心であるカーネルに伝わる図">
  <rect x="70" y="20" width="350" height="190" rx="12" fill="var(--panel-2, var(--panel))" stroke="var(--line)" stroke-width="2"/>
  <text x="84" y="40" font-size="11" fill="var(--ink-soft)">ターミナル（文字を映す窓口）</text>

  <rect x="110" y="56" width="280" height="134" rx="10" fill="var(--tool-bg)" stroke="var(--tool)" stroke-width="2"/>
  <text x="124" y="76" font-size="12" font-weight="700" fill="var(--tool)">シェル（受付の人）</text>
  <text x="124" y="94" font-size="10" fill="var(--ink-soft)">打たれた文字を読み解いて伝える</text>

  <rect x="160" y="110" width="180" height="62" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="250" y="136" font-size="12" text-anchor="middle" fill="var(--ink)">OSの中心</text>
  <text x="250" y="154" font-size="10" text-anchor="middle" fill="var(--ink-soft)">カーネル</text>

  <circle cx="32" cy="115" r="18" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="32" y="120" font-size="13" text-anchor="middle" fill="var(--ink)">人</text>
  <path d="M54 115 L64 115" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#t-arrow)"/>

  <defs>
    <marker id="t-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink-soft)"/>
    </marker>
  </defs>
</svg>
