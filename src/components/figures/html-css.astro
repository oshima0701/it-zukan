---
// 骨組みと、その上に着せる服。
---
<svg viewBox="0 0 440 200" role="img" aria-label="同じ骨組みに違う見た目を着せられる、という図">
  <text x="90" y="24" font-size="11" text-anchor="middle" fill="var(--language)">HTML：骨組み</text>
  <rect x="24" y="34" width="132" height="140" rx="8" fill="var(--panel)" stroke="var(--language)" stroke-width="2" stroke-dasharray="5 4"/>
  <g fill="none" stroke="var(--language)" stroke-width="1.5">
    <rect x="38" y="48" width="104" height="18" rx="3"/>
    <rect x="38" y="76" width="104" height="10" rx="3"/>
    <rect x="38" y="92" width="104" height="10" rx="3"/>
    <rect x="38" y="108" width="68" height="10" rx="3"/>
    <rect x="38" y="132" width="48" height="22" rx="3"/>
  </g>

  <text x="220" y="108" font-size="22" text-anchor="middle" fill="var(--ink-soft)">+</text>
  <text x="220" y="130" font-size="10" text-anchor="middle" fill="var(--ink-soft)">CSS</text>

  <text x="350" y="24" font-size="11" text-anchor="middle" fill="var(--ink)">見た目が決まる</text>
  <rect x="284" y="34" width="132" height="140" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <rect x="284" y="34" width="132" height="30" rx="8" fill="var(--language)" opacity="0.9"/>
  <text x="350" y="54" font-size="12" font-weight="700" text-anchor="middle" fill="var(--panel)">見出し</text>
  <g fill="var(--ink-soft)">
    <rect x="298" y="76" width="104" height="8" rx="4" opacity="0.5"/>
    <rect x="298" y="92" width="104" height="8" rx="4" opacity="0.5"/>
    <rect x="298" y="108" width="68" height="8" rx="4" opacity="0.5"/>
  </g>
  <rect x="298" y="132" width="60" height="24" rx="12" fill="var(--language)"/>
  <text x="328" y="148" font-size="10" text-anchor="middle" fill="var(--panel)">ボタン</text>
</svg>
