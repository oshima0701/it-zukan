---
// 効く頼み方の組み立て。
---
<svg viewBox="0 0 440 218" role="img" aria-label="役割・材料・やること・出す形の四つを揃えると頼み方が安定するという図">
  <g>
    <rect x="14" y="20" width="412" height="36" rx="8" fill="var(--ai-bg)" stroke="var(--ai)" stroke-width="2"/>
    <text x="28" y="43" font-size="11" fill="var(--ai)">役割</text>
    <text x="110" y="43" font-size="11" fill="var(--ink)">「初心者に説明する人として」</text>
  </g>
  <g>
    <rect x="14" y="64" width="412" height="36" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
    <text x="28" y="87" font-size="11" fill="var(--ink-soft)">材料</text>
    <text x="110" y="87" font-size="11" fill="var(--ink)">「この文章を使って」（貼り付ける）</text>
  </g>
  <g>
    <rect x="14" y="108" width="412" height="36" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
    <text x="28" y="131" font-size="11" fill="var(--ink-soft)">やること</text>
    <text x="110" y="131" font-size="11" fill="var(--ink)">「要点を取り出して」</text>
  </g>
  <g>
    <rect x="14" y="152" width="412" height="36" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
    <text x="28" y="175" font-size="11" fill="var(--ink-soft)">出す形</text>
    <text x="110" y="175" font-size="11" fill="var(--ink)">「3つの箇条書きで」</text>
  </g>
  <text x="220" y="208" font-size="10" text-anchor="middle" fill="var(--ink-soft)">材料を渡すほど、知らないことを作り出す余地が減る</text>
</svg>
