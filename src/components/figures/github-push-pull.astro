---
// 手元とネット上の置き場の往復。
---
<svg viewBox="0 0 440 190" role="img" aria-label="手元のパソコンとネット上の置き場のあいだを、プッシュとプルで行き来する図">
  <rect x="14" y="54" width="150" height="84" rx="10" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="89" y="84" font-size="12" text-anchor="middle" fill="var(--ink)">手元のパソコン</text>
  <text x="89" y="106" font-size="10" text-anchor="middle" fill="var(--ink-soft)">書く・記録する</text>
  <text x="89" y="124" font-size="10" text-anchor="middle" fill="var(--ink-soft)">ここだけなら誰も見ない</text>

  <rect x="276" y="54" width="150" height="84" rx="10" fill="var(--place-bg)" stroke="var(--place)" stroke-width="2"/>
  <text x="351" y="84" font-size="12" text-anchor="middle" fill="var(--place)">ネット上の置き場</text>
  <text x="351" y="106" font-size="10" text-anchor="middle" fill="var(--ink-soft)">みんなが見る</text>
  <text x="351" y="124" font-size="10" text-anchor="middle" fill="var(--ink-soft)">ここが正になる</text>

  <path d="M170 76 L270 76" stroke="var(--place)" stroke-width="2.5" fill="none" marker-end="url(#gh)"/>
  <text x="220" y="66" font-size="11" text-anchor="middle" fill="var(--place)">プッシュ</text>

  <path d="M270 116 L170 116" stroke="var(--ink-soft)" stroke-width="2.5" fill="none" marker-end="url(#gh2)"/>
  <text x="220" y="136" font-size="11" text-anchor="middle" fill="var(--ink-soft)">プル</text>

  <text x="220" y="172" font-size="10" text-anchor="middle" fill="var(--ink-soft)">送らないかぎり、手元の作業は誰にも見えない</text>

  <defs>
    <marker id="gh" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--place)"/>
    </marker>
    <marker id="gh2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink-soft)"/>
    </marker>
  </defs>
</svg>
