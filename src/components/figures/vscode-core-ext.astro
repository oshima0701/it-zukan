---
// 小さな本体に、必要な拡張だけを足していく形。
---
<svg viewBox="0 0 440 220" role="img" aria-label="小さな本体のまわりに、言語ごとの拡張機能を必要な分だけ足していく図">
  <circle cx="150" cy="110" r="54" fill="var(--tool-bg)" stroke="var(--tool)" stroke-width="2"/>
  <text x="150" y="106" font-size="12" font-weight="700" text-anchor="middle" fill="var(--tool)">本体</text>
  <text x="150" y="124" font-size="10" text-anchor="middle" fill="var(--ink-soft)">書く・探す・記録</text>

  <g>
    <circle cx="300" cy="44" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
    <text x="300" y="48" font-size="10" text-anchor="middle" fill="var(--ink-soft)">Python</text>
    <circle cx="368" cy="110" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
    <text x="368" y="114" font-size="10" text-anchor="middle" fill="var(--ink-soft)">AI補助</text>
    <circle cx="300" cy="176" r="30" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
    <text x="300" y="180" font-size="10" text-anchor="middle" fill="var(--ink-soft)">日本語</text>
  </g>

  <g stroke="var(--tool)" stroke-width="1.5" stroke-dasharray="4 4">
    <path d="M200 92 L272 54"/>
    <path d="M204 110 L338 110"/>
    <path d="M200 128 L272 166"/>
  </g>

  <text x="220" y="212" font-size="10" text-anchor="middle" fill="var(--ink-soft)">使うものだけ足す。足さなければ軽いまま</text>
</svg>
