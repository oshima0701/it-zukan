---
// アプリに同居する形と、別に立てて皆で使う形。
---
<svg viewBox="0 0 440 220" role="img" aria-label="データベースがアプリの中に同居する形と、別に立てて複数から使う形の比較図">
  <text x="104" y="20" font-size="10" fill="var(--data)">同居する形：1つのファイル</text>
  <rect x="14" y="30" width="180" height="120" rx="10" fill="var(--data-bg)" stroke="var(--data)" stroke-width="2"/>
  <rect x="34" y="48" width="140" height="34" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
  <text x="104" y="69" font-size="10" text-anchor="middle" fill="var(--ink)">アプリ</text>
  <rect x="34" y="94" width="140" height="38" rx="6" fill="var(--panel)" stroke="var(--data)" stroke-width="2"/>
  <text x="104" y="110" font-size="10" text-anchor="middle" fill="var(--data)">データの入った</text>
  <text x="104" y="124" font-size="10" text-anchor="middle" fill="var(--data)">ファイル1つ</text>
  <text x="104" y="172" font-size="9" text-anchor="middle" fill="var(--ink-soft)">用意が要らない。持ち運べる</text>
  <text x="104" y="188" font-size="9" text-anchor="middle" fill="var(--ink-soft)">同時に大勢で書くのは苦手</text>

  <text x="336" y="20" font-size="10" fill="var(--data)">別に立てる形：皆で使う</text>
  <rect x="246" y="30" width="180" height="120" rx="10" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <g>
    <rect x="256" y="42" width="48" height="26" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <rect x="312" y="42" width="48" height="26" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <rect x="368" y="42" width="48" height="26" rx="5" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="280" y="59" font-size="9" text-anchor="middle" fill="var(--ink-soft)">アプリ</text>
    <text x="336" y="59" font-size="9" text-anchor="middle" fill="var(--ink-soft)">アプリ</text>
    <text x="392" y="59" font-size="9" text-anchor="middle" fill="var(--ink-soft)">アプリ</text>
  </g>
  <g stroke="var(--data)" stroke-width="1.5">
    <path d="M280 68 L320 96"/><path d="M336 68 L336 96"/><path d="M392 68 L352 96"/>
  </g>
  <rect x="276" y="98" width="120" height="38" rx="6" fill="var(--data-bg)" stroke="var(--data)" stroke-width="2"/>
  <text x="336" y="114" font-size="10" text-anchor="middle" fill="var(--data)">データベース</text>
  <text x="336" y="128" font-size="9" text-anchor="middle" fill="var(--ink-soft)">常時動いている</text>
  <text x="336" y="172" font-size="9" text-anchor="middle" fill="var(--ink-soft)">大勢で同時に使える</text>
  <text x="336" y="188" font-size="9" text-anchor="middle" fill="var(--ink-soft)">立てて守る手間がかかる</text>
</svg>
