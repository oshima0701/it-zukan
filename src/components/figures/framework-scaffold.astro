---
// 骨組みが先にあって、空いた場所に自分の中身を入れる。
---
<svg viewBox="0 0 440 200" role="img" aria-label="フレームワークはあらかじめ骨組みが用意されていて、決められた場所に自分の処理を入れるという図">
  <rect x="14" y="26" width="412" height="130" rx="10" fill="var(--mechanism-bg)" stroke="var(--mechanism)" stroke-width="2"/>
  <text x="30" y="48" font-size="11" fill="var(--mechanism)">フレームワークが用意している骨組み</text>

  <g>
    <rect x="30" y="60" width="120" height="34" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="90" y="81" font-size="10" text-anchor="middle" fill="var(--ink-soft)">受け取る</text>
    <rect x="160" y="60" width="120" height="34" rx="6" fill="var(--panel)" stroke="var(--mechanism)" stroke-width="2" stroke-dasharray="5 4"/>
    <text x="220" y="76" font-size="10" text-anchor="middle" fill="var(--mechanism)">ここに自分の</text>
    <text x="220" y="89" font-size="10" text-anchor="middle" fill="var(--mechanism)">処理を書く</text>
    <rect x="290" y="60" width="120" height="34" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="350" y="81" font-size="10" text-anchor="middle" fill="var(--ink-soft)">返す</text>
  </g>

  <g>
    <rect x="30" y="106" width="185" height="34" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="122" y="127" font-size="10" text-anchor="middle" fill="var(--ink-soft)">安全の決まり・記録・設定</text>
    <rect x="225" y="106" width="185" height="34" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="317" y="127" font-size="10" text-anchor="middle" fill="var(--ink-soft)">データの出し入れ・画面の組み立て</text>
  </g>

  <text x="220" y="180" font-size="10" text-anchor="middle" fill="var(--ink-soft)">自由は減る。そのかわり、毎回ゼロから考えなくてよくなる</text>
</svg>
