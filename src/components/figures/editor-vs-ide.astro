---
// エディタ単体と、道具をひとつの箱にまとめたIDEの違い。
---
<svg viewBox="0 0 440 236" role="img" aria-label="左は文字を書く道具だけ、右は書く・動かす・調べる・つなぐ道具がひとつの箱に入っているという比較図">
  <text x="14" y="22" font-size="11" fill="var(--ink-soft)">エディタ：書く道具</text>
  <rect x="14" y="32" width="180" height="80" rx="10" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="104" y="78" font-size="12" text-anchor="middle" fill="var(--ink)">文字を書く</text>

  <g fill="var(--ink-soft)" font-size="10">
    <text x="14" y="140">別で用意するもの</text>
    <text x="14" y="160">・動かす道具</text>
    <text x="14" y="178">・間違いを調べる道具</text>
    <text x="14" y="196">・記録を残す道具</text>
  </g>

  <text x="246" y="22" font-size="11" fill="var(--tool)">IDE：ひとつの箱にまとまっている</text>
  <rect x="246" y="32" width="180" height="180" rx="10" fill="var(--tool-bg)" stroke="var(--tool)" stroke-width="2"/>
  <g>
    <rect x="260" y="46" width="152" height="40" rx="6" fill="var(--panel)" stroke="var(--tool)" stroke-width="1.5"/>
    <text x="336" y="71" font-size="11" text-anchor="middle" fill="var(--ink)">文字を書く</text>
    <rect x="260" y="94" width="72" height="34" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="296" y="115" font-size="10" text-anchor="middle" fill="var(--ink-soft)">動かす</text>
    <rect x="340" y="94" width="72" height="34" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="376" y="115" font-size="10" text-anchor="middle" fill="var(--ink-soft)">調べる</text>
    <rect x="260" y="136" width="72" height="34" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="296" y="157" font-size="10" text-anchor="middle" fill="var(--ink-soft)">記録する</text>
    <rect x="340" y="136" width="72" height="34" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="376" y="157" font-size="10" text-anchor="middle" fill="var(--ink-soft)">つなぐ</text>
    <rect x="260" y="178" width="152" height="22" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
    <text x="336" y="193" font-size="10" text-anchor="middle" fill="var(--ink-soft)">行き来せずに済む</text>
  </g>
</svg>
