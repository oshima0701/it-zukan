---
// フォルダの木構造と、そこへの道順としてのパス。
---
<svg viewBox="0 0 440 250" role="img" aria-label="Cドライブから順にフォルダをたどると目的のファイルに届く、木の形をした図">
  <g stroke="var(--line-strong, var(--ink-soft))" stroke-width="1.5" fill="none">
    <path d="M44 42 L44 210 L84 210"/>
    <path d="M44 100 L84 100"/>
    <path d="M44 156 L84 156"/>
    <path d="M124 118 L124 196 L164 196"/>
    <path d="M124 156 L164 156"/>
  </g>

  <g>
    <rect x="14" y="26" width="60" height="30" rx="6" fill="var(--mechanism-bg)" stroke="var(--mechanism)" stroke-width="2"/>
    <text x="44" y="46" font-size="11" text-anchor="middle" fill="var(--mechanism)">C:</text>
  </g>

  <rect x="84" y="86" width="86" height="28" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
  <text x="127" y="105" font-size="11" text-anchor="middle" fill="var(--ink-soft)">Program Files</text>

  <rect x="84" y="142" width="86" height="28" rx="6" fill="var(--mechanism-bg)" stroke="var(--mechanism)" stroke-width="2"/>
