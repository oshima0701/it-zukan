  <text x="127" y="215" font-size="11" text-anchor="middle" fill="var(--ink-soft)">Windows</text>

  <rect x="164" y="142" width="80" height="28" rx="6" fill="var(--mechanism-bg)" stroke="var(--mechanism)" stroke-width="2"/>
  <text x="204" y="161" font-size="11" text-anchor="middle" fill="var(--mechanism)">hoshi</text>

  <rect x="164" y="182" width="80" height="28" rx="6" fill="var(--panel)" stroke="var(--line)" stroke-width="1.5"/>
  <text x="204" y="201" font-size="11" text-anchor="middle" fill="var(--ink-soft)">public</text>

  <path d="M248 156 L286 156" stroke="var(--mechanism)" stroke-width="2" marker-end="url(#pt-arrow)"/>
  <rect x="290" y="136" width="136" height="40" rx="8" fill="var(--panel)" stroke="var(--mechanism)" stroke-width="2"/>
  <text x="358" y="152" font-size="10" text-anchor="middle" fill="var(--ink-soft)">たどった道順＝パス</text>
  <text x="358" y="168" font-size="10" text-anchor="middle" fill="var(--ink)">C:\Users\hoshi</text>

  <defs>
    <marker id="pt-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--mechanism)"/>
    </marker>
  </defs>
</svg>
