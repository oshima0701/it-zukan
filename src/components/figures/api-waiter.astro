---
// 注文を運ぶ店員。厨房には入らない。
---
<svg viewBox="0 0 440 200" role="img" aria-label="客が店員に注文し、店員が厨房へ伝えて料理を運ぶ。客は厨房に入らないという図">
  <rect x="14" y="58" width="96" height="56" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2"/>
  <text x="62" y="84" font-size="11" text-anchor="middle" fill="var(--ink)">客</text>
  <text x="62" y="101" font-size="9" text-anchor="middle" fill="var(--ink-soft)">使う側</text>

  <rect x="162" y="48" width="116" height="76" rx="10" fill="var(--mechanism-bg)" stroke="var(--mechanism)" stroke-width="2"/>
  <text x="220" y="78" font-size="12" font-weight="700" text-anchor="middle" fill="var(--mechanism)">店員</text>
  <text x="220" y="96" font-size="9" text-anchor="middle" fill="var(--ink-soft)">決まった頼み方だけ</text>
  <text x="220" y="112" font-size="9" text-anchor="middle" fill="var(--ink-soft)">受け付ける</text>

  <rect x="330" y="58" width="96" height="56" rx="8" fill="var(--panel)" stroke="var(--line)" stroke-width="2" stroke-dasharray="5 4"/>
  <text x="378" y="84" font-size="11" text-anchor="middle" fill="var(--ink-soft)">厨房</text>
  <text x="378" y="101" font-size="9" text-anchor="middle" fill="var(--ink-soft)">中は見えない</text>

  <g stroke="var(--mechanism)" stroke-width="2" fill="none" marker-end="url(#aw)">
    <path d="M114 74 L156 74"/>
    <path d="M284 74 L324 74"/>
  </g>
  <g stroke="var(--ink-soft)" stroke-width="2" fill="none" marker-end="url(#aw2)">
    <path d="M324 102 L284 102"/>
    <path d="M156 102 L114 102"/>
  </g>

  <text x="220" y="156" font-size="10" text-anchor="middle" fill="var(--ink-soft)">客は厨房に入らない。入れないからこそ、厨房は作り方を変えられる</text>
  <text x="220" y="176" font-size="10" text-anchor="middle" fill="var(--ink-soft)">決まった頼み方さえ変わらなければ、客は困らない</text>

  <defs>
    <marker id="aw" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--mechanism)"/>
    </marker>
    <marker id="aw2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--ink-soft)"/>
    </marker>
  </defs>
</svg>
