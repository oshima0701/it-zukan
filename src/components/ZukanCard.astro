---
// 図鑑カード。frontmatter の値だけで描く。全ページで項目の位置は動かず、
// タイプごとに色帯とバッジの色が変わる。
import { TYPES, STALE_AFTER_DAYS, type TypeKey } from '../config';
import Radar from './Radar.astro';

interface Props { data: any }
const { data } = Astro.props;

const type = data.type as TypeKey;
const t = TYPES[type];

const fmt = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;

const limit = STALE_AFTER_DAYS[type];
const days = Math.floor((Date.now() - new Date(data.updated).getTime()) / 86400000);
const stale = limit !== null && days > limit;
---
<aside class="card" style={`--c: var(--${type}); --cbg: var(--${type}-bg);`}>
  <div class="band"></div>
  <div class="body">
    <p class="no">No.{String(data.no).padStart(3, '0')}</p>
    <h2 class="name">{data.name} <span class="reading">（{data.reading}）</span></h2>
    <p class="badge">{t.badge}</p>
    <p class="one">{data.oneLine}</p>

    <dl>
      {data.born && (
        <>
          <dt>誕生年</dt>
          <dd>{data.born}年{data.bornNote ? `（${data.bornNote}）` : ''}</dd>
        </>
      )}
      {data.creators?.length && (
        <>
          <dt>生みの親</dt>
          <dd>{data.creators.map((c: any) => c.name).join('、')}</dd>
        </>
      )}
      {data.birthplace && (<><dt>出身地</dt><dd>{data.birthplace.label}</dd></>)}
      {data.mascot && (
        <>
          <dt>マスコット</dt>
          <dd>{data.mascot.name}{data.mascot.origin ? `（${data.mascot.origin}）` : ''}</dd>
        </>
      )}
      {data.officialUrl && (
        <>
          <dt>公式</dt>
          <dd><a href={data.officialUrl} rel="noopener">{data.officialUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></dd>
        </>
      )}
    </dl>

    <Radar status={data.status} type={type} />

    <p class="stamp">
      <span class="updated">この内容は {fmt(new Date(data.updated))} 時点</span>
      {stale && <span class="stale">情報が古い可能性があります</span>}
    </p>
  </div>
</aside>

<style>
  .card {
    background: var(--panel); border: 1px solid var(--line); border-radius: 14px;
    box-shadow: var(--shadow); overflow: hidden; margin: 0 0 2rem;
  }
  .band { height: 6px; background: var(--c); }
  .body { padding: 1.1rem 1.2rem 1.3rem; }
  .no { margin: 0; font-size: .72rem; letter-spacing: .08em; color: var(--ink-soft); }
  .name { margin: .1rem 0 .2rem; font-size: 1.4rem; line-height: 1.3; }
  .reading { font-size: .82rem; color: var(--ink-soft); font-weight: 400; }
  .badge {
    display: inline-block; margin: .2rem 0 .7rem; padding: .1rem .6rem;
    border-radius: 999px; background: var(--cbg); color: var(--c);
    font-size: .74rem; font-weight: 700;
  }
  .one { margin: 0 0 1rem; font-size: .95rem; }
  dl {
    margin: 0 0 1.2rem; display: grid; grid-template-columns: 5.4em 1fr;
    gap: .2rem .6rem; font-size: .84rem; line-height: 1.6;
  }
  dt { color: var(--ink-soft); }
  dd { margin: 0; overflow-wrap: anywhere; }
  .stamp {
    margin: 1rem 0 0; padding-top: .7rem; border-top: 1px dashed var(--line);
    font-size: .72rem; color: var(--ink-soft);
    display: flex; flex-wrap: wrap; gap: .2rem 1rem;
  }
  /* 古さの注記も色や大きさを変えない。強調は1ページ1か所の決まりのため。 */
  .stale::before { content: "／ "; }
</style>
