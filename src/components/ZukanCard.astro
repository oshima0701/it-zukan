---
// 図鑑カード。frontmatter の値だけで描く。全ページで項目の位置は動かず、
// タイプごとに色帯・絵記号・バッジの色が変わる。
// タイプは色だけに頼らず、帯の中のバッジに文字（「ツールタイプ」など）で必ず書く。
import { TYPES, STALE_AFTER_DAYS, type TypeKey } from '../config';
import Radar from './Radar.astro';
import TypeIcon from './TypeIcon.astro';

interface Props { data: any }
const { data } = Astro.props;

const type = data.type as TypeKey;
const t = TYPES[type];

const fmt = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;

const limit = STALE_AFTER_DAYS[type];
const days = Math.floor((Date.now() - new Date(data.updated).getTime()) / 86400000);
const stale = limit !== null && days > limit;
---
<aside class="card" style={`--c: var(--${type}); --cbg: var(--${type}-bg);`}>
  <div class="strip">
    <p class="no">No.{String(data.no).padStart(3, '0')}</p>
    <p class="badge"><TypeIcon type={type} size={15} />{t.badge}</p>
  </div>

  <div class="body">
    <div class="head">
      <span class="watermark" aria-hidden="true"><TypeIcon type={type} size={84} /></span>
      <h2 class="name">{data.name}</h2>
      <p class="reading">{data.reading}</p>
      <p class="one">{data.oneLine}</p>
    </div>

    <section class="status" aria-label="ステータス">
      <p class="status-title" aria-hidden="true">ステータス</p>
      <Radar status={data.status} type={type} />
    </section>

    <dl>
      {data.born && (
        <>
          <dt>誕生年</dt>
          <dd>{data.born}年{data.bornNote ? `（${data.bornNote}）` : ''}</dd>
        </>
      )}
      {data.creators?.length && (
        <>
          <dt>生みの親</dt>
          <dd>{data.creators.map((c: any) => c.name).join('、')}</dd>
        </>
      )}
      {data.birthplace && (<><dt>出身地</dt><dd>{data.birthplace.label}</dd></>)}
      {data.mascot && (
        <>
          <dt>マスコット</dt>
          <dd>{data.mascot.name}{data.mascot.origin ? `（${data.mascot.origin}）` : ''}</dd>
        </>
      )}
      {data.officialUrl && (
        <>
          <dt>公式</dt>
          <dd><a href={data.officialUrl} rel="noopener">{data.officialUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></dd>
        </>
      )}
    </dl>

    <p class="stamp">
      <span class="updated">この内容は {fmt(new Date(data.updated))} 時点</span>
      {stale && <span class="stale">情報が古い可能性があります</span>}
    </p>
  </div>
</aside>

<style>
  .card {
    position: relative;
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-l);
    box-shadow: var(--shadow); overflow: hidden; margin: 0 0 1.6rem;
  }
  /* カード上端の色帯。ここでタイプを色・絵記号・文字の3つで示す */
  .strip {
    display: flex; align-items: center; justify-content: space-between; gap: .6rem;
    padding: .5rem 1rem; background: var(--c); color: var(--on-c);
    background-image: repeating-linear-gradient(
      135deg, color-mix(in srgb, var(--on-c) 12%, transparent) 0 5px, transparent 5px 11px);
  }
  .no { margin: 0; font-size: .8rem; font-weight: 700; letter-spacing: .12em; font-variant-numeric: tabular-nums; }
  .badge {
    margin: 0; display: inline-flex; align-items: center; gap: .35rem;
    padding: .05rem .65rem .05rem .5rem; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--on-c) 70%, transparent);
    font-size: .76rem; font-weight: 700; line-height: 1.7;
  }

  .body { padding: 0 0 1.1rem; }

  .head { position: relative; padding: 1.1rem 1.2rem .3rem; }
  .watermark {
    position: absolute; right: .7rem; top: .6rem; color: var(--c); opacity: .13; line-height: 0;
  }
  .name { position: relative; margin: 0; font-size: 1.85rem; line-height: 1.25; font-weight: 800; letter-spacing: .01em; }
  .reading { position: relative; margin: .15rem 0 .7rem; font-size: .84rem; color: var(--ink-soft); letter-spacing: .06em; }
  .one { position: relative; margin: 0; font-size: .94rem; line-height: 1.75; }

  .status {
    margin: .9rem 1rem 0; padding: .55rem .6rem .4rem;
    background: var(--cbg); border-radius: var(--radius-m);
  }
  .status-title { margin: 0 0 -.3rem .4rem; font-size: .7rem; letter-spacing: .14em; color: var(--ink-soft); }

  dl {
    margin: .9rem 1.2rem 0; display: grid; grid-template-columns: 5.4em 1fr;
    font-size: .84rem; line-height: 1.65;
  }
  dt, dd { padding: .45rem 0; border-top: 1px dotted var(--line-strong); }
  dt { color: var(--ink-soft); }
  dd { margin: 0; overflow-wrap: anywhere; }
  dd a { text-decoration-color: var(--ink-soft); }

  .stamp {
    margin: .3rem 1.2rem 0; padding-top: .6rem; border-top: 1px dotted var(--line-strong);
    font-size: .72rem; line-height: 1.6; color: var(--ink-soft);
    display: flex; flex-wrap: wrap; gap: .1rem 1rem;
  }
  /* 古さの注記も色や大きさを変えない。強調は1ページ1か所の決まりのため。 */
  .stale::before { content: "／ "; }
</style>
