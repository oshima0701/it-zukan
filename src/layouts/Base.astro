---
import '../styles/tokens.css';
import { SITE_TITLE } from '../config';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`}</title>
  <meta name="description" content={description} />
  <link rel="sitemap" href={`${base}sitemap-index.xml`} />
  <script is:inline>
    // 画面が出る前に明るさを決める（切り替わって見えるのを防ぐ）
    try {
      var t = localStorage.getItem('theme');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">本文へ飛ぶ</a>
  <header class="top">
    <a class="home" href={base}>{SITE_TITLE}</a>
    <div class="right">
      <a href={`${base}zukan/`}>図鑑一覧</a>
      <ThemeToggle />
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <div class="foot-wrap"><Footer /></div>

<style>
  .skip {
    position: absolute; left: -9999px;
  }
  .skip:focus {
    left: 1rem; top: 1rem; z-index: 10; background: var(--panel);
    padding: .5rem .8rem; border: 1px solid var(--line); border-radius: 8px;
  }
  .top {
    max-width: 68rem; margin: 0 auto; padding: 1.1rem 1rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .home { font-weight: 700; text-decoration: none; }
  .right { display: flex; align-items: center; gap: 1rem; font-size: .86rem; }
  main { max-width: 68rem; margin: 0 auto; padding: 0 1rem; }
  .foot-wrap { max-width: 68rem; margin: 0 auto; padding: 0 1rem; }
</style>
</body>
</html>
