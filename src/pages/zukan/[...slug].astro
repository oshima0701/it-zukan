---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ZukanCard from '../../components/ZukanCard.astro';
import Toc from '../../components/Toc.astro';
import Figure from '../../components/Figure.astro';
import Photo from '../../components/Photo.astro';
import Cite from '../../components/Cite.astro';
import { TYPES, type TypeKey } from '../../config';

export async function getStaticPaths() {
  const all = await getCollection('zukan');
  const live = all.filter((e) => !e.data.draft);
  return live.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: live },
  }));
}

const { entry, all } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;

const byId = new Map(all.map((e: any) => [e.id, e]));
const RELATION_LABEL: Record<string, string> = {
  partner: '相棒',
  rival: 'ライバル',
  ancestor: '先祖',
  descendant: '子孫',
};
const related = d.related
  .map((r: any) => ({ ...r, entry: byId.get(r.slug) }))
  .filter((r: any) => r.entry);

const type = d.type as TypeKey;
---
<Base title={`${d.name}（${d.reading}）`} description={d.oneLine}>
  <article class="page" style={`--c: var(--${type}); --cbg: var(--${type}-bg);`}>

    <p class="surprise">{d.surprise}</p>

    <div class="cols">
      <div class="side">
        <ZukanCard data={d} />
        <Toc headings={headings} />
      </div>

      <div class="main">
        {d.disputed && (
          <p class="disputed">このページには諸説ある話が含まれます。本文で「諸説あり」と書いた箇所は、情報源によって説が分かれています。</p>
        )}

        <div class="body prose">
          <Content components={{ Figure, Photo, Cite }} />
        </div>

        {related.length > 0 && (
          <section class="related">
            <h2 id="related">相棒・ライバル</h2>
            <ul>
              {related.map((r: any) => (
                <li>
                  <a href={`${base}zukan/${r.entry.id}/`}>{r.entry.data.name}</a>
                  <span class="rel">{RELATION_LABEL[r.relation]}</span>
                  {r.note && <span class="note">{r.note}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}

        <p class="takeaway">{d.takeaway}</p>

        <section class="sources">
          <h2 id="sources">出典</h2>
          <ol>
            {d.sources.map((s: any) => (
              <li id={`src-${s.id}`}>
                <a href={s.url} rel="noopener">{s.title}</a>
                <small>（{new Date(s.accessed).toISOString().slice(0, 10)} 閲覧）</small>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </div>
  </article>
</Base>

<style>
  .page { padding: 1.2rem 0 0; }

  /* 冒頭の「意外な一文」。大きさも色も本文のまま、左の細い線だけを添える */
  .surprise {
    margin: 0 0 2rem; padding: .2rem 0 .2rem 1.1rem;
    font-size: 1.1rem; line-height: 1.9; max-width: var(--measure);
    border-left: 2px solid var(--line-strong);
  }

  .cols { display: grid; gap: 1.2rem; }
  .side { max-width: 30rem; }
  @media (min-width: 900px) {
    .cols { grid-template-columns: 19.5rem minmax(0, 1fr); gap: 3rem; align-items: start; }
    /* 左の列は本文と同じ高さまで伸ばし、カードは流れ、目次だけが付いてくる */
    .side { align-self: stretch; max-width: none; }
  }

  .main { min-width: 0; }
  .body { max-width: var(--measure); }

  .disputed {
    max-width: var(--measure); margin: 0 0 1.5rem; padding: .7rem 1rem;
    border: 1px dashed var(--line-strong); border-radius: var(--radius-s);
    font-size: .84rem; line-height: 1.75; color: var(--ink-soft);
  }

  .related, .sources { max-width: var(--measure); }
  .related h2, .sources h2 {
    margin: 3rem 0 .8rem; padding-top: .9rem;
    font-size: 1.22rem; line-height: 1.55;
    border-top: 1px solid var(--line-strong);
  }
  .related ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .related li {
    display: flex; flex-wrap: wrap; gap: .1rem .7rem; align-items: baseline;
    padding: .55rem .9rem; background: var(--panel);
    border: 1px solid var(--line); border-radius: var(--radius-m);
  }
  .related li a { font-weight: 700; }
  .rel {
    font-size: .72rem; color: var(--ink-soft);
    border: 1px solid var(--line-strong); border-radius: 999px; padding: 0 .55rem;
  }
  .note { font-size: .82rem; color: var(--ink-soft); }

  /* ページで唯一、色と大きさを変える場所。ラベル・縁・背景だけがタイプ色を受ける */
  .takeaway {
    position: relative; overflow: hidden;
    max-width: var(--measure);
    margin: 3.4rem 0 0; padding: 2.7rem 1.4rem 1.4rem 1.5rem;
    background: var(--cbg); color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
    border-left: 6px solid var(--c); border-radius: 4px var(--radius-m) var(--radius-m) 4px;
    font-size: 1.3rem; font-weight: 700; line-height: 1.75;
  }
  .takeaway::before {
    content: "今日のひとこと";
    position: absolute; left: 1.5rem; top: .85rem;
    font-size: .76rem; font-weight: 700; letter-spacing: .14em; color: var(--c);
  }

  .sources ol {
    margin: 0; padding: 0; list-style: none; counter-reset: src;
    display: grid; gap: .5rem; font-size: .86rem; line-height: 1.7;
  }
  .sources li {
    counter-increment: src; position: relative;
    padding: .1rem .5rem .1rem 2.2rem; border-radius: var(--radius-s);
  }
  .sources li::before {
    content: counter(src); position: absolute; left: .2rem; top: .25rem;
    width: 1.35rem; height: 1.35rem; border-radius: 50%;
    border: 1px solid var(--line-strong); color: var(--ink-soft);
    font-size: .7rem; line-height: 1.25rem; text-align: center; font-variant-numeric: tabular-nums;
  }
  .sources a { overflow-wrap: anywhere; }
  .sources small { color: var(--ink-soft); font-size: .76rem; margin-left: .2rem; }
  .sources li:target { background: var(--panel-2); box-shadow: inset 0 0 0 1px var(--line-strong); }
</style>

<script is:inline define:vars={{ slug: entry.id }}>
  // 読んだ記録。末尾の「今日のひとこと」が画面に入った時点で登録する。
  // ボタンを押させる形は押し忘れで登録率が意味を失い、
  // 開いただけで登録する形は「読んだ記録」にならないため、この判定にしている。
  (function () {
    function read() {
      try {
        var v = JSON.parse(localStorage.getItem('zukan:read') || '[]');
        return Array.isArray(v) ? v : [];
      } catch (e) { return []; }
    }
    function save(list) {
      try { localStorage.setItem('zukan:read', JSON.stringify(list)); } catch (e) {}
    }

    var target = document.querySelector('.takeaway');
    if (!target || !('IntersectionObserver' in window)) return;

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var list = read();
        if (list.indexOf(slug) === -1) { list.push(slug); save(list); }
        io.disconnect();
      });
    }, { threshold: 0.6 });
    io.observe(target);
  })();
</script>
