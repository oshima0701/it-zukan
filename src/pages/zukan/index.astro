---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import { TYPES, TYPE_ORDER, STALE_AFTER_DAYS, type TypeKey } from '../../config';

const all = (await getCollection('zukan')).filter((e) => !e.data.draft);
const base = import.meta.env.BASE_URL;

const items = all
  .map((e) => {
    const type = e.data.type as TypeKey;
    const limit = STALE_AFTER_DAYS[type];
    const days = Math.floor((Date.now() - new Date(e.data.updated).getTime()) / 86400000);
    return {
      slug: e.id,
      name: e.data.name,
      reading: e.data.reading,
      aliases: e.data.aliases,
      oneLine: e.data.oneLine,
      no: e.data.no,
      order: e.data.order,
      type,
      updated: new Date(e.data.updated).toISOString().slice(0, 10),
      stale: limit !== null && days > limit,
      // 絞り込み用。名前・読み方・別名をまとめた文字列
      haystack: [e.data.name, e.data.reading, ...e.data.aliases].join(' ').toLowerCase(),
    };
  })
  .sort((a, b) => a.order - b.order);

const counts = TYPE_ORDER.map((t) => ({
  key: t,
  label: TYPES[t].label,
  n: items.filter((i) => i.type === t).length,
}));
---
<Base title="図鑑一覧" description="載っている技術の一覧。タイプと名前で絞り込めます。">
  <h1>図鑑一覧</h1>
  <p class="lede">全 {items.length} 種。学ぶ順に並んでいます。</p>

  <div class="controls">
    <label class="search">
      <span class="visually-hidden">名前で絞り込む</span>
      <svg class="glass" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"
           fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5L21 21" />
      </svg>
      <input type="search" id="q" placeholder="名前・読み方で絞り込む（例: ギット）" autocomplete="off" />
    </label>

    <div class="filters" role="group" aria-label="タイプで絞り込む">
      <button type="button" class="chip on" data-type="all" aria-pressed="true">すべて（{items.length}）</button>
      {counts.map((c) => (
        <button type="button" class="chip" data-type={c.key} aria-pressed="false"
                style={`--c: var(--${c.key}); --cbg: var(--${c.key}-bg);`}>
          <TypeIcon type={c.key} size={15} />{c.label}（{c.n}）
        </button>
      ))}
    </div>

    <label class="sort">
      <span>並び</span>
      <select id="sort">
        <option value="order">学ぶ順</option>
        <option value="no">図鑑番号</option>
        <option value="updated">更新が古い順</option>
      </select>
    </label>
  </div>

  <p class="empty" id="empty" hidden>当てはまる項目がありません。</p>

  <ul class="list" id="list">
    {items.map((i) => (
      <li class="row" data-type={i.type} data-haystack={i.haystack}
          data-order={i.order} data-no={i.no} data-updated={i.updated}
          style={`--c: var(--${i.type}); --cbg: var(--${i.type}-bg);`}>
        <a href={`${base}zukan/${i.slug}/`}>
          <span class="band" aria-hidden="true">
            <TypeIcon type={i.type} size={22} />
            <span class="num">{String(i.no).padStart(3, '0')}</span>
          </span>
          <span class="text">
            <span class="head">
              <strong>{i.name}</strong>
              <span class="reading">{i.reading}</span>
              <span class="badge">{TYPES[i.type].label}</span>
            </span>
            <span class="one">{i.oneLine}</span>
            <span class="meta">
              No.{String(i.no).padStart(3, '0')} ／ {i.updated} 時点
              {i.stale && <span> ／ 情報が古い可能性があります</span>}
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  h1 { font-size: 1.7rem; margin: 1.4rem 0 .2rem; font-weight: 800; letter-spacing: .03em; }
  .lede { color: var(--ink-soft); font-size: .92rem; margin: 0 0 1.5rem; }

  .controls { display: grid; gap: .9rem; margin-bottom: 1.5rem; }

  .search { position: relative; display: block; max-width: 26rem; }
  .search .glass { position: absolute; left: .85rem; top: 50%; transform: translateY(-50%); color: var(--ink-soft); pointer-events: none; }
  .search input {
    width: 100%; min-height: 2.75rem; padding: .55rem .9rem .55rem 2.6rem;
    border: 1px solid var(--line-strong); border-radius: 999px;
    background: var(--panel); color: var(--ink); font: inherit; font-size: .92rem;
  }
  .search input::placeholder { color: var(--ink-soft); }

  .filters { display: flex; flex-wrap: wrap; gap: .45rem; }
  .chip {
    display: inline-flex; align-items: center; gap: .35rem; min-height: 2.5rem;
    border: 1px solid var(--line-strong); background: var(--panel); color: var(--ink-soft);
    border-radius: 999px; padding: .2rem .9rem; font: inherit; font-size: .82rem; cursor: pointer;
    transition: background-color .15s ease, border-color .15s ease;
  }
  .chip:hover { border-color: var(--c, var(--ink-soft)); }
  .chip.on {
    background: var(--cbg, var(--ink)); color: var(--c, var(--bg));
    border-color: var(--c, var(--ink)); font-weight: 700;
    box-shadow: inset 0 0 0 1px var(--c, var(--ink));
  }

  .sort { display: flex; align-items: center; gap: .5rem; font-size: .84rem; color: var(--ink-soft); }
  .sort select {
    font: inherit; font-size: .86rem; min-height: 2.5rem; padding: .3rem 1rem .3rem .8rem;
    border: 1px solid var(--line-strong); border-radius: 999px;
    background: var(--panel); color: var(--ink);
  }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; }
  .row a {
    display: flex; text-decoration: none;
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-m);
    overflow: hidden; box-shadow: var(--shadow-s);
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .row a:hover { border-color: var(--c); box-shadow: var(--shadow); }
  /* 左のタイル：絵記号と図鑑番号。色は面で見せ、タイプ名は右のバッジが文字で示す */
  .band {
    flex: 0 0 4.4rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .15rem;
    background: var(--cbg); color: var(--c); border-right: 1px solid var(--line);
  }
  .num { font-size: .72rem; font-weight: 700; letter-spacing: .1em; font-variant-numeric: tabular-nums; }
  .text { display: block; padding: .8rem 1rem .85rem; min-width: 0; }
  .head { display: flex; flex-wrap: wrap; gap: 0 .6rem; align-items: baseline; }
  .head strong { font-size: 1.1rem; line-height: 1.6; }
  .reading { font-size: .76rem; color: var(--ink-soft); }
  .badge {
    font-size: .7rem; font-weight: 700; color: var(--c);
    background: var(--cbg); border-radius: 999px; padding: .05rem .6rem;
  }
  .one { display: block; font-size: .88rem; line-height: 1.75; margin-top: .1rem; }
  .meta { display: block; font-size: .72rem; color: var(--ink-soft); margin-top: .3rem; line-height: 1.6; }
  .empty { color: var(--ink-soft); font-size: .9rem; padding: 1rem 0; }
  .row[hidden] { display: none; }
</style>

<script is:inline>
  (function () {
    var list = document.getElementById('list');
    var rows = Array.prototype.slice.call(list.querySelectorAll('.row'));
    var q = document.getElementById('q');
    var sort = document.getElementById('sort');
    var empty = document.getElementById('empty');
    var chips = Array.prototype.slice.call(document.querySelectorAll('.chip'));
    var type = 'all';

    function apply() {
      var text = q.value.trim().toLowerCase();
      var shown = 0;
      rows.forEach(function (r) {
        var okType = type === 'all' || r.dataset.type === type;
        var okText = !text || r.dataset.haystack.indexOf(text) !== -1;
        var show = okType && okText;
        r.hidden = !show;
        if (show) shown++;
      });
      empty.hidden = shown !== 0;
    }

    function resort() {
      var key = sort.value;
      var sorted = rows.slice().sort(function (a, b) {
        if (key === 'updated') return a.dataset.updated.localeCompare(b.dataset.updated);
        return Number(a.dataset[key]) - Number(b.dataset[key]);
      });
      sorted.forEach(function (r) { list.appendChild(r); });
    }

    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        type = c.dataset.type;
        chips.forEach(function (x) {
          x.classList.toggle('on', x === c);
          x.setAttribute('aria-pressed', x === c ? 'true' : 'false');
        });
        apply();
      });
    });
    q.addEventListener('input', apply);
    sort.addEventListener('change', resort);
  })();
</script>
