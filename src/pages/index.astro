---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TownMap from '../components/TownMap.astro';
import TypeIcon from '../components/TypeIcon.astro';
import { TYPES, TYPE_ORDER, SITE_TITLE, SITE_TAGLINE, type TypeKey } from '../config';

const all = (await getCollection('zukan')).filter((e) => !e.data.draft);
const base = import.meta.env.BASE_URL;

const items = all
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ slug: e.id, name: e.data.name, type: e.data.type as TypeKey }));

const grouped = TYPE_ORDER.map((t) => ({
  key: t,
  label: TYPES[t].label,
  blurb: TYPES[t].blurb,
  members: items.filter((i) => i.type === t),
}));
---
<Base title="IT技術図鑑" description={SITE_TAGLINE}>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p class="lede">{SITE_TAGLINE}</p>
  </section>

  <div class="progress">
    <p class="counter">
      発見 <strong><span id="found">0</span> / {items.length} 種</strong>
      <span class="bar" aria-hidden="true"><i id="bar"></i></span>
    </p>
    <ul class="legend" aria-label="タイプ別の種数">
      {grouped.map((g) => (
        <li style={`--c: var(--${g.key}); --cbg: var(--${g.key}-bg);`}>
          <TypeIcon type={g.key} size={14} />{g.label}<span class="n">{g.members.length}</span>
        </li>
      ))}
    </ul>
  </div>

  <TownMap items={items} />
  <p class="scrollhint">地図は横にスクロールできます。名前を押すとそのページへ進みます。</p>

  <h2>区画ごとの一覧</h2>
  <p class="note">地図を横に動かさずに探したいときはこちらから。</p>
  <div class="zones">
    {grouped.map((g) => (
      <section class="zone" style={`--c: var(--${g.key}); --cbg: var(--${g.key}-bg);`}>
        <h3><TypeIcon type={g.key} size={18} />{g.label}</h3>
        <p class="blurb">{g.blurb}</p>
        {g.members.length === 0
          ? <p class="none">まだ住人がいません。</p>
          : <ul>{g.members.map((m) => <li><a href={`${base}zukan/${m.slug}/`}>{m.name}</a></li>)}</ul>}
      </section>
    ))}
  </div>
</Base>

<style>
  .hero { padding: 1.6rem 0 .4rem; }
  h1 { margin: 0; font-size: 2.1rem; line-height: 1.3; font-weight: 800; letter-spacing: .04em; }
  .lede { color: var(--ink-soft); margin: .3rem 0 1.4rem; font-size: .98rem; }

  .progress {
    display: grid; gap: .8rem; margin: 0 0 1.2rem; padding: .9rem 1.1rem;
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius-m);
    box-shadow: var(--shadow-s);
  }
  @media (min-width: 760px) {
    .progress { grid-template-columns: minmax(16rem, 22rem) 1fr; align-items: center; gap: 1.5rem; }
  }
  .counter {
    display: flex; align-items: center; gap: .9rem; flex-wrap: wrap;
    font-size: .88rem; color: var(--ink-soft); margin: 0; line-height: 1.6;
  }
  .counter strong { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums; }
  .bar {
    flex: 1 1 120px; min-width: 100px; height: 8px; border-radius: 999px;
    background: var(--line); overflow: hidden;
  }
  .bar i {
    display: block; height: 100%; width: 0%; border-radius: 999px;
    background: linear-gradient(90deg, var(--language), var(--ai));
    transition: width .5s ease;
  }
  .legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .legend li {
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .1rem .7rem .1rem .55rem; border-radius: 999px;
    background: var(--cbg); color: var(--c);
    font-size: .78rem; font-weight: 700; line-height: 1.7;
  }
  .legend .n { font-variant-numeric: tabular-nums; color: var(--ink); font-weight: 400; margin-left: .15rem; }

  .scrollhint { margin: .5rem 0 0; font-size: .78rem; color: var(--ink-soft); }
  @media (min-width: 760px) { .scrollhint { display: none; } }

  h2 { font-size: 1.15rem; margin: 3rem 0 .3rem; }
  .note { color: var(--ink-soft); font-size: .84rem; margin: 0 0 1rem; }
  .zones { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .zones { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .zones { grid-template-columns: repeat(3, 1fr); } }
  .zone {
    background: var(--panel); border: 1px solid var(--line);
    border-top: 4px solid var(--c); border-radius: var(--radius-m); padding: .8rem 1.1rem 1rem;
  }
  .zone h3 {
    display: flex; align-items: center; gap: .4rem;
    margin: 0; font-size: 1rem; color: var(--c); line-height: 1.6;
  }
  .blurb { margin: 0 0 .6rem; font-size: .76rem; color: var(--ink-soft); line-height: 1.6; }
  .zone ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; }
  .zone li a {
    display: inline-block; padding: .1rem .7rem; font-size: .86rem; line-height: 1.8;
    background: var(--cbg); border-radius: 999px; text-decoration: none;
  }
  .zone li a:hover { box-shadow: inset 0 0 0 1px var(--c); }
  .none { margin: 0; font-size: .84rem; color: var(--ink-soft); }
</style>

<script is:inline>
  // 読んだ記録は localStorage。使えない環境でも表示が壊れないようにする。
  (function () {
    var read = [];
    try {
      read = JSON.parse(localStorage.getItem('zukan:read') || '[]');
      if (!Array.isArray(read)) read = [];
    } catch (e) { read = []; }

    var total = document.querySelectorAll('.zone li').length;
    var found = document.getElementById('found');
    var bar = document.getElementById('bar');
    if (found) found.textContent = String(read.length);
    if (bar && total > 0) bar.style.width = Math.min(100, (read.length / total) * 100) + '%';

    read.forEach(function (slug) {
      var a = document.querySelector('a[data-slug="' + slug + '"]');
      if (a) a.setAttribute('data-read', '1');
    });
  })();
</script>
